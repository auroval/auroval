/target/
**/*.rs.bk
*.pdb

# Python bytecode from tools/
__pycache__/
*.py[cod]

# Python caches and virtualenvs
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Build and check output. These are not a category the repository has needed
# before; they are here because `check.log` and `verify.log` were committed to
# main by accident on 2026-11-09, from a `git add -A` in a worktree where a
# cargo run had been redirected to a file beside the manifest. Scratch output
# belongs outside the tree, and when it is not, this catches it.
*.log

# Editor and OS droppings
*.swp
*~
.DS_Store

# Zola's build output. The site is generated from site/content, site/templates
# and site/sass; what lands in site/public is a build artefact and is deployed
# from CI rather than committed.
/site/public/
# Zola's image-processing cache, which only exists once a template resizes
# something. Nothing does yet, and when something does this keeps the resized
# copies out of the tree.
/site/static/processed_images/
